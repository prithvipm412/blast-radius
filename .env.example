# Copy to .env and fill in real values. Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=blast_radius

# --- LLM provider ---
# one of: gemini, groq
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub (for ingest + create_incident_issue) ---
GITHUB_TOKEN=
GITHUB_REPO=GoogleCloudPlatform/microservices-demo
# repo issues are created in dry_run mode unless explicitly disabled
ACT_DRY_RUN=true

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Web (frontend reads this to find the API) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

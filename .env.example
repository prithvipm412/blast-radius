# Copy to .env and fill in real values. Never commit .env.

# --- FalkorDB ---
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH=blast_radius

# --- LLM provider ---
# one of: gemini, groq
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- GitHub (for ingest, and create_incident_issue's real dry_run=False filing) ---
GITHUB_TOKEN=
GITHUB_REPO=GoogleCloudPlatform/microservices-demo
# A *different* repo to file real incident issues against - never the upstream source repo.
GITHUB_ISSUE_REPO=

# --- API ---
# Comma-separated origins allowed to call this API. Defaults to the local web dev ports
# (3000, 3001) if unset; in deployment, set to your frontend's real URL (see DEPLOY.md).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Web (frontend reads this to find the API) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MOCK=0
